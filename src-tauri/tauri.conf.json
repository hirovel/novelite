{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "novelite",
  "version": "1.0.4",
  "identifier": "com.novelite.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Novelite",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGM0M5NUQ3NUZEMjhGNjAKUldSZ2o5SmYxNVU4bnlHa01wQldpVjRHT1ZIdmp1eUozYVlUSndMVTYxT1VrK0t3akV3N2V3amcK",
      "endpoints": [
        "https://github.com/hirovel/novelite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
